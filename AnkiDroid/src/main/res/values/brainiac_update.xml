    <string name="update_failure_network">no connection to GitHub</string>
    <string name="update_failure_rate_limited">GitHub limits the number of requests, try again later</string>
    <string name="update_failure_http">GitHub answered with HTTP %1$d</string>
    <string name="update_failure_invalid_response">GitHub sent an unexpected answer</string>
    <string name="update_failure_host">the download went to an address outside GitHub</string>
    <string name="update_failure_size">the download has the wrong size</string>
    <string name="update_failure_digest">the download does not match its checksum</string>
    <string name="update_failure_not_apk">the download is not an app Android can read</string>
    <string name="update_failure_wrong_package">the download is a different app</string>
    <string name="update_failure_not_newer">the download is not newer than the installed version</string>
    <string name="update_failure_wrong_variant">the download is a different kind of build (universal or per processor)</string>
    <string name="update_failure_signature">the download is not signed with the key of the installed app</string>
    <string name="update_failure_storage">the download could not be saved</string>
    <string name="update_failure_permission">Brainiac is not allowed to install apps</string>
    <string name="update_failure_install">Android could not install it (%1$s)</string>
