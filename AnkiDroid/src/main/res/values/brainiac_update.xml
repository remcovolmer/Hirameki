    <string name="update_canceled">Installation canceled</string>
    <string name="update_needs_permission">Brainiac may not install apps yet.</string>
    <string name="update_failed">Update failed: %1$s</string>

    <!-- Dialog before the download -->
    <string name="update_confirm_title">Update Brainiac to %1$s?</string>
    <string name="update_confirm_versions">Installed: %1$s\nNew: %2$s</string>
    <string name="update_confirm_size">Download: %1$s</string>
    <string name="update_confirm_notes">What\'s new</string>
    <string name="update_confirm_no_notes">No release notes.</string>
    <string name="update_confirm_install">Download and install</string>

    <!-- Permission to install apps -->
    <string name="update_permission_title">Allow installing updates</string>
    <string name="update_permission_text">Android only installs updates from apps you allow. On the next screen, turn on \"Allow from this source\" for Brainiac, then go back.</string>

    <!-- Settings row -->
    <string name="update_settings_title">App updates</string>
    <string name="update_settings_version">Version %1$s</string>
    <string name="update_settings_not_supported">This build is updated by the store it was installed from.</string>
    <string name="update_check_now">Check for updates</string>
    <string name="update_auto_check">Check automatically</string>
    <string name="update_auto_check_summary">At most once a day, when the app opens</string>
    <string name="update_status_checking">Checking…</string>
    <string name="update_status_up_to_date">You have the latest version (%1$s).</string>
    <string name="update_status_available">Version %1$s is available.</string>
    <string name="update_status_no_asset">Version %1$s is out, but without a download for this build (%2$s).</string>
    <string name="update_status_unknown_install">This build has no release version, so it cannot be updated.</string>
    <string name="update_status_failed">Could not check for updates: %1$s</string>

