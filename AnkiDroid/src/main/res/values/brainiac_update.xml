<resources>
    <!-- Banner -->
    <string name="update_available_title">Update available: %1$s → %2$s</string>
    <string name="update_action_update">Update</string>
    <string name="update_action_dismiss">Dismiss</string>
    <string name="update_downloading">Downloading… %1$d%%</string>
    <string name="update_verifying">Checking the download…</string>
    <string name="update_installing">Installing…</string>
    <string name="update_waiting_for_android">Waiting for Android to finish the installation…</string>
